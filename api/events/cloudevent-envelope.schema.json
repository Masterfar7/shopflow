{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopflow.io/schemas/events/cloudevent-envelope.json",
  "title": "ShopFlowCloudEventEnvelope",
  "description": "Standardized CloudEvents 1.0 envelope for all ShopFlow Kafka event streams",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "correlation_id",
    "causation_id",
    "data"
  ],
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0",
      "description": "CloudEvents specification version"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event ID generated by Outbox publisher"
    },
    "source": {
      "type": "string",
      "description": "Identifier of the originating service/domain",
      "examples": ["shopflow/order-service", "shopflow/inventory-service", "shopflow/payment-service"]
    },
    "type": {
      "type": "string",
      "description": "Fully-qualified event type name",
      "pattern": "^shopflow\\.[a-z_]+\\.[a-z_]+\\.v[0-9]+$"
    },
    "subject": {
      "type": "string",
      "description": "Aggregate ID / Kafka partition key (e.g. order_id)"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the event occurred in UTC"
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "description": "Root transaction/saga UUID traversing service boundaries"
    },
    "causation_id": {
      "type": "string",
      "format": "uuid",
      "description": "ID of preceding message or command triggering this event"
    },
    "traceparent": {
      "type": "string",
      "description": "W3C Distributed Tracing header for OpenTelemetry propagation"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Original client request idempotency key"
    },
    "data": {
      "type": "object",
      "description": "Domain-specific event payload"
    }
  }
}
