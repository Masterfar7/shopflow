{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopflow.io/schemas/events/orders/order-created.v1.json",
  "title": "OrderCreatedPayloadV1",
  "type": "object",
  "required": [
    "order_id",
    "order_number",
    "customer_id",
    "saga_id",
    "items",
    "total_amount_minor",
    "currency",
    "payment_token",
    "shipping_address",
    "created_at"
  ],
  "properties": {
    "order_id": { "type": "string", "format": "uuid" },
    "order_number": { "type": "string" },
    "customer_id": { "type": "string" },
    "saga_id": { "type": "string", "format": "uuid" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sku",
          "title_snapshot",
          "unit_price_minor",
          "quantity",
          "line_total_minor"
        ],
        "properties": {
          "sku": { "type": "string" },
          "title_snapshot": { "type": "string" },
          "unit_price_minor": { "type": "integer", "minimum": 0 },
          "quantity": { "type": "integer", "minimum": 1 },
          "line_total_minor": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "total_amount_minor": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "payment_token": { "type": "string" },
    "shipping_address": {
      "type": "object",
      "required": ["recipient_name", "street", "city", "state", "postal_code", "country"],
      "properties": {
        "recipient_name": { "type": "string" },
        "street": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "postal_code": { "type": "string" },
        "country": { "type": "string" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
